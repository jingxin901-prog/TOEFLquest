# Supabase public browser configuration (safe to expose when RLS is enabled)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional server-side proxies for later phases. Never put provider API keys here.
VITE_AI_PROXY_URL=
VITE_NOTIFICATION_PROXY_URL=

# Server/Edge Function only. Never rename this to a VITE_ variable.
FEISHU_WEBHOOK_URL=
